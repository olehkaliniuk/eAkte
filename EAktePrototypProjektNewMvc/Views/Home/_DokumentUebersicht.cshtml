@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using EAktePrototypProjektNewMvc.Models
@model EAktePrototypProjektNewMvc.Models.Dokumente.DokumentListViewModel

@functions {
    public (string IconClass, string Color) GetFileIconInfo(string? extension)
    {
        if (string.IsNullOrWhiteSpace(extension))
            return ("fa-solid fa-file", "#6481a5");

        switch (extension.Trim('.').ToLowerInvariant())
        {
            case "doc":
            case "docx":
                return ("fa-solid fa-file-word", "#2b579a");
            case "xls":
            case "xlsx":
            case "csv":
                return ("fa-solid fa-file-excel", "#217346");
            case "ppt":
            case "pptx":
                return ("fa-solid fa-file-powerpoint", "#d24726");
            case "pdf":
                return ("fa-solid fa-file-pdf", "#e02424");
            case "txt":
                return ("fa-solid fa-file-lines", "#6b7280");
            case "msg":
            case "eml":
                return ("fa-solid fa-envelope", "#0072c6");
            case "zip":
            case "rar":
            case "7z":
                return ("fa-solid fa-file-zipper", "#c9a227");
            case "jpg":
            case "jpeg":
            case "png":
            case "gif":
            case "bmp":
            case "svg":
                return ("fa-solid fa-file-image", "#8e44ad");
            case "mp4":
            case "avi":
            case "mov":
            case "mkv":
                return ("fa-solid fa-file-video", "#e67e22");
            case "mp3":
            case "wav":
                return ("fa-solid fa-file-audio", "#16a085");
            case "xml":
            case "json":
                return ("fa-solid fa-file-code", "#34495e");
            default:
                return ("fa-solid fa-file", "#6481a5");
        }
    }
}


@{
    var tableTitle = Model.Table switch
    {
        "my"      => "Meine Dokumente",
        "deleted" => "Gelöschte Dokumente",
        "overview" => "Dokumentübersicht",
        _         => "Dokumentübersicht"
    };
}

@{
    var isDeleted = Model.Table == "deleted";
}

@functions{
    public IHtmlContent SortHeader(string column, string title, string currentColumn, string currentDirection)
    {
        var arrowHtml = "";
        if (currentColumn == column)
        {
            arrowHtml = currentDirection == "asc"
                ? " <span class=\"sort-arrow sort-asc\">▲</span>"
                : " <span class=\"sort-arrow sort-desc\">▼</span>";
        }
        var safeTitle = HtmlEncoder.Default.Encode(title ?? "");
        return new HtmlString(
            $"<th onclick=\"sortTable('{column}')\" style=\"cursor:pointer;\">{safeTitle}{arrowHtml}</th>"
        );
    }

    // Betreff/Version werden bewusst auf Subject/VersionNr gemappt — das sind die
    // tatsächlichen Filter-Properties, die ApplyFilters im Controller liest.
    string GetSearchValue(string key) => key switch
    {
        "Name"          => Model.Search.Name,
        "Subject"       => Model.Search.Betreff,
        "Aktenzeichen"  => Model.Search.Aktenzeichen,
        "CreatorName"   => Model.Search.CreatorName,
        "Modifier"      => Model.Search.Modifier,
        "VersionNr"     => Model.Search.Version,
        _ => ""
    };
}

<input type="hidden" id="currentSortColumn" value="@Model.SortColumn" />
<input type="hidden" id="currentSortDirection" value="@Model.SortDirection" />
<input type="hidden" id="dokUebersichtObjectId" value="@Model.ObjectId" />
<input type="hidden" id="dokUebersichtNodeType" value="@Model.NodeType" />
<input type="hidden" id="currentNodeType" value="Dokument" />
<input type="hidden" id="tableEndpoint" value="@(Model.Table switch {
    "my" => "/bescheidbearbeitung/load-meine-dokumente",
    "deleted" => "/bescheidbearbeitung/load-dokumente-deleted",
    _ => "/bescheidbearbeitung/load-dokumentenuebersicht"
})" />

<div class="hierarchy-table">
<div class="table-container" id="dokument-table-container" data-parent-id="@Model.ObjectId">
    <div class="table-container-inner" id="dokument-drop-zone">
            <h2 class="table-header-text">@tableTitle</h2>
            <table>
            <thead>
               <tr class="search">
                    <th class="actions"></th>
                    @foreach (var col in Model.Columns)
                    {
                        <th>
                            @if (col.IsSearchable)
                            {
                                if (col.ColumnKey == "CreationDate")
                                {
                                    <div style="display:flex; gap:4px;">
                                        <span class="von-bis">Von:</span>
                                        <input type="date" id="searchCreationDateVon" value="@(Model.Search.CreationDateVon?.ToString("yyyy-MM-dd"))" />
                                        <span class="von-bis">Bis:</span>
                                        <input type="date" id="searchCreationDateBis" value="@(Model.Search.CreationDateBis?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                }
                                else if (col.ColumnKey == "ModifyDate")
                                {
                                    <div style="display:flex; gap:4px;">
                                        <span class="von-bis">Von:</span>
                                        <input type="date" id="searchModifyDateVon" value="@(Model.Search.ModifyDateVon?.ToString("yyyy-MM-dd"))" />
                                        <span class="von-bis">Bis:</span>
                                        <input type="date" id="searchModifyDateBis" value="@(Model.Search.ModifyDateBis?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                }
                                else
                                {
                                    <input data-search-column="@col.ColumnKey" value="@GetSearchValue(col.ColumnKey)" placeholder="Suchen.." />
                                }
                            }
                        </th>
                    }
                </tr>
                <tr>
                    <th>Aktionen</th>
                    @foreach (var col in Model.Columns)
                    {
                        if (col.IsSortable)
                        {
                            @SortHeader(col.ColumnKey, col.Title, Model.SortColumn, Model.SortDirection)
                        }
                        else
                        {
                            <th>@col.Title</th>
                        }
                    }
              </tr>
            </thead>
            <tbody>
                @if (Model.Dokumente != null && Model.Dokumente.Count > 0)
                {
                    foreach (var k in Model.Dokumente)
                    {
                        var isEditable = !string.IsNullOrEmpty(k.FileExtension) &&
                            new[] { ".docx", ".doc", ".xlsx", ".xls", ".pptx", ".ppt" }
                                .Contains(k.FileExtension.ToLower());
                        var isLocked = !string.IsNullOrEmpty(k.LockedFrom);

                        <tr class="js-table-node" data-object-id="@k.ObjektId"
                                data-node-type="Dokument"
                                data-parent-object-id="@Model.ObjectId"
                                data-version-id="@k.VersionId"
                                data-filename="@($"{k.Name}{k.FileExtension}")"
                                data-locked-by="@k.LockedFrom"
                                data-deleted="@k.IsDeleted">

                            <td>
                                <div class="versions-actions-div">
                                    @if (isDeleted)
                                    {
                                        <i class="fa-solid fa-rotate-left btn-info-table btn-restore"
                                           title="Wiederherstellen: @k.Name"
                                           style="cursor:pointer"
                                           onclick="restoreDokument('@k.ObjektId', event)"></i>
                                        <i class="fa-solid fa-trash-can btn-info-table btn-purge"
                                           title="Endgültig löschen: @k.Name"
                                           style="cursor:pointer; margin-left:5px; color:#c0392b"
                                           onclick="purgeDokument('@k.ObjektId', event)"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-circle-info btn-info-table" title="Info zu @k.Name"
                                           onclick="toggleInfo('@k.ObjektId', event)"></i>
                                        <i class="fa-solid fa-circle-chevron-right btn-info-table weiter-btn"
                                           title="Klicken um eine eben tiefer zu navigieren." style="margin-left:5px"></i>

                                        @if (isEditable)
                                        {
                                            <div class="btn-divider" style="display:flex"></div>
                                            <i class="fa-solid fa-pen-to-square btn-edit"
                                               data-version-id="@k.VersionId"
                                               data-filename="@(k.Name)@(k.FileExtension)"
                                               title="Herunterladen &amp; in Word bearbeiten"
                                               style="cursor:pointer; @(isLocked ? "display:none;" : "")">
                                            </i>
                                        }

                                        <i class="fa-solid fa-key edit-pending-key"
                                           data-version-id="@k.VersionId"
                                           title="@(isLocked ? $"Wird gerade von {k.LockedFrom} bearbeitet" : "Wird gerade in Word bearbeitet")"
                                           style="display:@(isLocked ? "inline-block" : "none"); color:#c9a227; cursor:default;">
                                        </i>
                                    }
                                </div>
                            </td>

                            @foreach (var col in Model.Columns)
                            {
                                switch (col.ColumnKey)
                                {
                                    case "Name":
                                        <td>
                                            @{ var iconInfo = GetFileIconInfo(k.FileExtension); }
                                            <i class="@iconInfo.IconClass" style="color:@iconInfo.Color; font-size:1.2rem;"></i>
                                            <span class="node-name">@k.Name @if (k.IstAusVorlagenverwaltung) { <span>Vorlagenverwaltung</span> }</span>
                                        </td>
                                        break;
                                    case "Subject":
                                        <td>@k.Betreff</td>
                                        break;
                                    case "Aktenzeichen":
                                        <td>@k.Aktenzeichen</td>
                                        break;
                                    case "CreationDate":
                                        <td>@k.CreationDate?.ToString("dd.MM.yyyy")</td>
                                        break;
                                    case "CreatorName":
                                        <td>@k.CreatorName</td>
                                        break;
                                    case "ModifyDate":
                                        <td>@k.ModifyDate?.ToString("dd.MM.yyyy")</td>
                                        break;
                                    case "Modifier":
                                        <td>@k.Modifier</td>
                                        break;
                                    case "VersionNr":
                                        <td><span class="v-badge v-badge-active">@k.Version</span></td>
                                        break;
                                    default:
                                        <td></td>
                                        break;
                                }
                            }
                        </tr>

                        <tr id="info-@k.ObjektId" class="info-row" style="display:none;">
                            <td colspan="@(Model.Columns.Count + 1)">
                                <div class="info-content">
                                    <div class="info-item">
                                        <span class="info-label">Objekt-Typ:</span>
                                        <span class="info-value">Dokument</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">Name:</span>
                                        <span class="info-value">@k.Name</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">Inhaltstyp:</span>
                                        <span class="info-value">@k.ContentType</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">Dateigröße:</span>
                                        <span class="info-value">@k.ContentSize</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">Erstellungsdatum:</span>
                                        <span class="info-value">@k.CreationDate</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">Ersteller:</span>
                                        <span class="info-value">@k.CreatorName</span>
                                    </div>
                                    <div class="info-item">
                                        <span class="info-label">Objekt-Id:</span>
                                        <span class="info-value">
                                            <a href="@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@k.ObjektId">@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@k.ObjektId</a>
                                        </span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(Model.Columns.Count + 1)" style="text-align:center;">Keine Einträge gefunden</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<div class="pagination-container">

    <div class="pagination-buttons">
        @{ bool isEmpty = Model.TotalPages == 0; }

        <button class="p-btn" onclick="loadPage(1)"
            @(Model.CurrentPage == 1 || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-double-left"></i>
        </button>
        <button class="p-btn" onclick="loadPage(@(Model.CurrentPage - 1))"
            @(Model.CurrentPage == 1 || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-left"></i>
        </button>

        <div class="pagination-page-info">
            <input id="currentPage" type="number" min="1"
                max="@Model.TotalPages" value="@Model.CurrentPage"
                @(isEmpty ? "disabled" : "") />
            <span class="pagination-sep">von</span>
            <span class="pagination-total">@Model.TotalPages</span>
        </div>

        <button class="p-btn" onclick="loadPage(@(Model.CurrentPage + 1))"
            @(Model.CurrentPage >= Model.TotalPages || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-right"></i>
        </button>
        <button class="p-btn" onclick="loadPage(@Model.TotalPages)"
            @(Model.CurrentPage >= Model.TotalPages || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-double-right"></i>
        </button>
    </div>

    <div class="page-size">
        <label class="pagination-label">Einträge pro Seite</label>
        <select id="pageSizeSelect" class="pagination-select">
            @foreach (var size in new[] { 1, 5, 10, 25, 50, 100 })
            {
                var selected = Model.PageSize == size ? "selected" : "";
                @:<option value="@size" @selected>@size</option>
            }
        </select>
    </div>

    <div class="actions2">
        <span class="pagination-label">Gesamt</span>
        <input class="pagination-count-input" name="name" value="@Model.TotalCount" readonly />
        <button id="resetBtn" class="p-btn" title="Aktualisieren">
            <i class="fa fa-sync"></i>
        </button>
        <button class="p-btn" title="Spalten anpassen" onclick="openColumnDialog('Dokument')">
            <i class="fa-solid fa-table-columns"></i>
        </button>
        <button class="p-btn" onclick="loadPage(1)" title="Suchen">
            <i class="fa fa-search"></i>
        </button>
    </div>

</div>
</div>

<script>
(function () {

    const endPoint = document.getElementById("tableEndpoint")?.value ?? "/bescheidbearbeitung/load-dokumentenuebersicht";
    const tableContainer = () => document.getElementById("tableContainer");

    function getValue(id, fallback = "") {
        return document.getElementById(id)?.value ?? fallback;
    }

    function getFilters() {
        const filters = {
            objectId: getValue("dokUebersichtObjectId"),
            nodeType: getValue("dokUebersichtNodeType"),
            pageSize: getValue("pageSizeSelect", 10),

            CreationDateVon: getValue("searchCreationDateVon"),
            CreationDateBis: getValue("searchCreationDateBis"),
            ModifyDateVon: getValue("searchModifyDateVon"),
            ModifyDateBis: getValue("searchModifyDateBis")
        };

        document.querySelectorAll("[data-search-column]").forEach(i => {
            filters[i.dataset.searchColumn] = i.value;
        });

        return filters;
    }

    function fetchTable(params) {
        const query = new URLSearchParams(params);
        fetch(`${endPoint}?${query}`)
            .then(r => r.text())
            .then(html => {
                tableContainer().innerHTML = html;
                attachEvents();
            });
    }

    window.loadPage = function (page = 1) {
        fetchTable({ ...getFilters(), page });
    };

    window.sortTable = function (column) {
        const currentColumn = getValue("currentSortColumn");
        const currentDirection = getValue("currentSortDirection", "asc");

        const newDirection =
            currentColumn === column && currentDirection === "asc"
                ? "desc"
                : "asc";

        fetchTable({
            ...getFilters(),
            page: 1,
            sortColumn: column,
            sortDirection: newDirection
        });
    };

    function attachEvents() {

        const searchInputs = () =>
            document.querySelectorAll(
                "[data-search-column], #searchCreationDateVon, #searchCreationDateBis, #searchModifyDateVon, #searchModifyDateBis"
            );

        searchInputs().forEach(input =>
            input.addEventListener("keypress", e => {
                if (e.key === "Enter") window.loadPage(1);
            })
        );

        document.getElementById("pageSizeSelect")
            ?.addEventListener("change", () => window.loadPage(1));

        document.getElementById("currentPage")
            ?.addEventListener("input", e => {
                const page = parseInt(e.target.value, 10);
                const max = parseInt(e.target.max, 10);
                if (!isNaN(page)) {
                    if (page < 1) return e.target.value = 1;
                    if (page > max) return e.target.value = max;
                    window.loadPage(page);
                }
            });

        document.getElementById("resetBtn")
            ?.addEventListener("click", () => {
                searchInputs().forEach(i => i.value = "");
                document.getElementById("pageSizeSelect").value = 10;
                window.loadPage(1);
            });
    }

    attachEvents();

})();
</script>