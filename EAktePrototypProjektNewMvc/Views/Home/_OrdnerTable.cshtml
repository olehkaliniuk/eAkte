@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using EAktePrototypProjektNewMvc.Models

@functions{
    public IHtmlContent SortHeader(string column, string title, string currentColumn, string currentDirection)
    {
        var arrowHtml = "";
        if (currentColumn == column)
        {
            arrowHtml = currentDirection == "asc"
                ? " <span class=\"sort-arrow sort-asc\">▲</span>"
                : " <span class=\"sort-arrow sort-desc\">▼</span>";
        }
        var safeTitle = HtmlEncoder.Default.Encode(title ?? "");
        return new HtmlString(
            $"<th onclick=\"sortTable('{column}')\" style=\"cursor:pointer;\">{safeTitle}{arrowHtml}</th>"
        );
    }

    string GetSearchValue(string key) => key switch
    {
        "Name"        => Model.Search.Name,
        "Type"        => Model.Search.Type,
        "CreatorName" => Model.Search.CreatorName,
        _ => ""
    };
}
<input type="hidden" id="currentSortColumn" value="@Model.SortColumn" />
<input type="hidden" id="currentSortDirection" value="@Model.SortDirection" />

<input type="hidden" id="parentObjectId" value="@Model.Vorgang.ObjektId" />

<input type="hidden" id="currentNodeType" value="Ordner" />




<div class="object-container">
    <div class="object-container-inner">

        <div class="info-header">
            <h2>    
            @if (Model.Vorgang.Icon != null && Model.Vorgang.Icon.Length > 0)
            {
            var base64 = Convert.ToBase64String(Model.Vorgang.Icon);
            var imgSrc = $"data:image/x-icon;base64,{base64}";

                <img src="@imgSrc" style="width:1em;" />
            }
            else
            {
                <span class="toggle-icon">
                    <i class="fa-solid fa-folder"></i>
                </span>
            }
            @Model.Vorgang.Aktenzeichen
        </h2>
            <i class="fa-solid fa-circle-info btn-info-table" title="Info zu @Model.Vorgang.Aktenzeichen" onclick="toggleInfo('@Model.Vorgang.ObjektId', event)"></i>
        </div>

        <!-- Info -->
        <div id="info-@Model.Vorgang.ObjektId" class="info-row" style="display:none;">
      
               <div class="info-content">

                <div class="info-item">
                    <span class="info-label">Objekt-Typ:</span>
                    <span class="info-value">Vorgang</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Aktenzeichen:</span>
                    <span class="info-value">@Model.Vorgang.Aktenzeichen</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Zulassungsnummer:</span>
                    <span class="info-value">@Model.Vorgang.Zulassungsnummer</span>
                </div>

                <div class="info-item">
                    <span class="info-label">UserID:</span>
                    <span class="info-value">@Model.Vorgang.UserID</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Abteilung:</span>
                    <span class="info-value">@Model.Vorgang.Abteilung</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Stelle:</span>
                    <span class="info-value">@Model.Vorgang.Stelle</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Antragsart:</span>
                    <span class="info-value">@Model.Vorgang.Antragsart</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Bescheidtyp:</span>
                    <span class="info-value">@Model.Vorgang.Bescheidtyp</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Gegenstand:</span>
                    <span class="info-value">@Model.Vorgang.Gegenstand</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Betreff:</span>
                    <span class="info-value">@Model.Vorgang.Betreff</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Bemerkung:</span>
                    <span class="info-value">@Model.Vorgang.Bemerkung</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Status:</span>
                    <span class="info-value">@Model.Vorgang.Status</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Aktenzustand:</span>
                    <span class="info-value">@Model.Vorgang.Aktenzustand</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Datum Antrag:</span>
                    <span class="info-value">@Model.Vorgang.DatumAntrag?.ToString("dd.MM.yyyy")</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Erzeugt von:</span>
                    <span class="info-value">@Model.Vorgang.ErzeugtVon</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Erzeugt am:</span>
                    <span class="info-value">@Model.Vorgang.ErzeugtAm?.ToString("dd.MM.yyyy")</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Veröffentlicht:</span>
                    <span class="info-value">@(Model.Vorgang.Veroeffentlicht ? "Ja" : "Nein")</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Objekt-Id:</span>
                    <span class="info-value">
                        <a href="@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@Model.Vorgang.ObjektId">@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@Model.Vorgang.ObjektId</a>
                    </span>
                </div>


            </div>
        </div>

    </div>
</div>



<div class="hierarchy-table">
<div class="table-container">
    <div class="table-container-inner">
            <h2 class="table-header-text">Ordner von <span>@Model.Vorgang.Aktenzeichen</span></h2>
            <table>
            <thead>
              <tr class="search">
                    <th class="actions"></th>
                    @foreach (var col in Model.Columns)
                    {
                        <th>
                            @if (col.IsSearchable)
                            {
                                if (col.ColumnKey == "CreationDate")
                                {
                                    <div style="display:flex; gap:4px;">
                                        <span class="von-bis">Von:</span>
                                        <input type="date" id="searchCreationDateVon" value="@(Model.Search.CreationDateVon?.ToString("yyyy-MM-dd"))" />
                                        <span class="von-bis">Bis:</span>
                                        <input type="date" id="searchCreationDateBis" value="@(Model.Search.CreationDateBis?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                }
                                else
                                {
                                    <input data-search-column="@col.ColumnKey" value="@GetSearchValue(col.ColumnKey)" placeholder="Suchen.." />
                                }
                            }
                        </th>
                    }
                </tr>
                <tr>
                    <th>Aktionen</th>
                    @foreach (var col in Model.Columns)
                    {
                        if (col.IsSortable)
                        {
                            @SortHeader(col.ColumnKey, col.Title, Model.SortColumn, Model.SortDirection)
                        }
                        else
                        {
                            <th>@col.Title</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Ordner != null && Model.Ordner.Count > 0)
                {
                    foreach (var k in Model.Ordner)
                    {
                        <tr class="js-table-node" data-object-id="@k.ObjektId" data-node-type="Ordner">
                        <td>
                            <i class="fa-solid fa-circle-info btn-info-table" title="Info zu @k.Name" onclick="toggleInfo('@k.ObjektId', event)"></i>
                            <i class="fa-solid fa-circle-chevron-right btn-info-table weiter-btn" title="Klicken um eine eben tiefer zu navigieren." style="margin-left:5px"></i>
                         </td>
                          @foreach (var col in Model.Columns)
                            {
                                switch (col.ColumnKey)
                                {
                                    case "Name":
                                        <td><i class="fa-solid fa-folder" style="color:orange"></i> @k.Name</td>
                                        break;
                                    case "CreationDate":
                                        <td>@k.CreationDate.ToString("dd.MM.yyyy")</td>
                                        break;
                                    case "Type":
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <div style="height:5px; width:5px; background:orange; border-radius:2px;"></div>
                                                @k.Type
                                            </div>
                                        </td>
                                        break;
                                    case "CreatorName":
                                        <td>@k.CreatorName</td>
                                        break;
                                    default:
                                        <td></td>
                                        break;
                                }
                            }
                        </tr>

                        <!-- Info -->
                        <tr id="info-@k.ObjektId" class="info-row" style="display:none;">
                            <td colspan="@(Model.Columns.Count + 1)">   
                              <div class="info-content">

                            <div class="info-item">
                                <span class="info-label">Objekt-Typ:</span>
                                <span class="info-value">Ordner</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Name:</span>
                                <span class="info-value">@k.Name</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">CreationDate:</span>
                                <span class="info-value">@k.CreationDate.ToString("dd.MM.yyyy")</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">ModifyDate:</span>
                                <span class="info-value">@k.ModifyDate?.ToString("dd.MM.yyyy")</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Type:</span>
                                <span class="info-value">@k.Type</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Bemerkung:</span>
                                <span class="info-value">@k.Bemerkungen</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Creator:</span>
                                <span class="info-value">@k.CreatorName</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Modifier:</span>
                                <span class="info-value">@k.Modifier</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Owner:</span>
                                <span class="info-value">@k.OwnerName</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Hauptgruppe:</span>
                                <span class="info-value">@k.Hauptsachgebiet</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Nebengruppe:</span>
                                <span class="info-value">@k.Sachgebiet</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Aktenzeichen:</span>
                                <span class="info-value">@k.Aktenzeichen</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">LfdNr:</span>
                                <span class="info-value">@k.LfdNr</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Status:</span>
                                <span class="info-value">@k.Status</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Final:</span>
                                <span class="info-value">@(k.Final ? "Ja" : "Nein")</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Objekt-Id:</span>
                                <span class="info-value">
                                    <a href="@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@k.ObjektId">@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@k.ObjektId</a>
                                </span>
                            </div>

                        </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="@(Model.Columns.Count + 1)" style="text-align:center;">Keine Einträge gefunden</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>



<div class="pagination-container">

    <div class="pagination-buttons">
        @{ bool isEmpty = Model.TotalPages == 0; }

        <button class="p-btn" onclick="loadPage(1)"
            @(Model.CurrentPage == 1 || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-double-left"></i>
        </button>
        <button class="p-btn" onclick="loadPage(@(Model.CurrentPage - 1))"
            @(Model.CurrentPage == 1 || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-left"></i>
        </button>

        <div class="pagination-page-info">
            <input id="currentPage" type="number" min="1"
                max="@Model.TotalPages" value="@Model.CurrentPage"
                @(isEmpty ? "disabled" : "") />
            <span class="pagination-sep">von</span>
            <span class="pagination-total">@Model.TotalPages</span>
        </div>

        <button class="p-btn" onclick="loadPage(@(Model.CurrentPage + 1))"
            @(Model.CurrentPage >= Model.TotalPages || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-right"></i>
        </button>
        <button class="p-btn" onclick="loadPage(@Model.TotalPages)"
            @(Model.CurrentPage >= Model.TotalPages || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-double-right"></i>
        </button>
    </div>

    <!-- Einträge pro Seite -->
    <div class="page-size">
        <label class="pagination-label">Einträge pro Seite</label>
        <select id="pageSizeSelect" class="pagination-select">
            @foreach (var size in new[] { 1, 5, 10, 25, 50, 100 })
            {
                var selected = Model.PageSize == size ? "selected" : "";
                @:<option value="@size" @selected>@size</option>
            }
        </select>
    </div>

    <!-- Gesamtanzahl + Actions -->
    <div class="actions2">
        <span class="pagination-label">Gesamt</span>
        <input class="pagination-count-input" name="name" value="@Model.TotalCount" readonly />
        <button id="resetBtn" class="p-btn" title="Aktualisieren">
            <i class="fa fa-sync"></i>
        </button>
        <button class="p-btn" title="Spalten anpassen" onclick="openColumnDialog('Ordner')">
            <i class="fa-solid fa-table-columns"></i>
        </button>
        <button class="p-btn" onclick="loadPage(1)" title="Suchen">
            <i class="fa fa-search"></i>
        </button>
    </div>

</div>
</div>






<script>
(function () {

const endPoint = "/bescheidbearbeitung/load-ordner";



const tableContainer = () => document.getElementById("tableContainer");

function getValue(id, fallback = "") {
    return document.getElementById(id)?.value ?? fallback;
}

function getFilters() {
    const filters = {
        pageSize: getValue("pageSizeSelect", 10),
        objectId: getValue("parentObjectId"),

        // CreationDate ist ein Von/Bis-Zeitraum, kein einzelnes Suchfeld.
        CreationDateVon: getValue("searchCreationDateVon"),
        CreationDateBis: getValue("searchCreationDateBis")
    };

    document.querySelectorAll("[data-search-column]").forEach(i => {
        filters[i.dataset.searchColumn] = i.value;
    });

    return filters;
}

function fetchTable(params) {
    const query = new URLSearchParams(params);
    fetch(`${endPoint}?${query}`)
        .then(r => r.text())
        .then(html => {
            tableContainer().innerHTML = html;
            attachEvents();
        });
}

window.loadPage = function (page = 1) {
    fetchTable({ ...getFilters(), page });
};

window.sortTable = function (column) {
    const currentColumn = getValue("currentSortColumn");
    const currentDirection = getValue("currentSortDirection", "asc");

    const newDirection =
        currentColumn === column && currentDirection === "asc"
            ? "desc"
            : "asc";

    fetchTable({
        ...getFilters(),
        page: 1,
        sortColumn: column,
        sortDirection: newDirection
    });
};

function attachEvents() {

    const searchInputs = () =>
        document.querySelectorAll("[data-search-column], #searchCreationDateVon, #searchCreationDateBis");

    searchInputs().forEach(input =>
        input.addEventListener("keypress", e => {
            if (e.key === "Enter") window.loadPage(1);
        })
    );

    document.getElementById("pageSizeSelect")
        ?.addEventListener("change", () => window.loadPage(1));

    document.getElementById("currentPage")
        ?.addEventListener("input", e => {
            const page = parseInt(e.target.value, 10);
            const max = parseInt(e.target.max, 10);

            if (!isNaN(page)) {
                if (page < 1) return e.target.value = 1;
                if (page > max) return e.target.value = max;
                window.loadPage(page);
            }
        });

    document.getElementById("resetBtn")
        ?.addEventListener("click", () => {
            searchInputs().forEach(i => i.value = "");
            document.getElementById("pageSizeSelect").value = 10;
            window.loadPage(1);
        });
}

attachEvents();

})();
</script>

