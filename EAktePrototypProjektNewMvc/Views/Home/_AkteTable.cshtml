@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using EAktePrototypProjektNewMvc.Models
@model EAktePrototypProjektNewMvc.Models.Akten.AkteViewModel

@functions{
    public IHtmlContent SortHeader(string column, string title, string currentColumn, string currentDirection)
    {
        var arrowHtml = "";
        if (currentColumn == column)
        {
            arrowHtml = currentDirection == "asc"
                ? " <span class=\"sort-arrow sort-asc\">▲</span>"
                : " <span class=\"sort-arrow sort-desc\">▼</span>";
        }

        // Titel kommt aus der DB, deshalb encodieren.
        var safeTitle = HtmlEncoder.Default.Encode(title ?? "");
        return new HtmlString(
            $"<th onclick=\"sortTable('{column}')\" style=\"cursor:pointer;\">{safeTitle}{arrowHtml}</th>"
        );
    }

    // ErzeugtAm hat kein einzelnes Suchfeld, sondern einen Von/Bis-Zeitraum
    // und wird deshalb im Such-Header separat behandelt, nicht über diese Funktion.
    string GetSearchValue(string key) => key switch
    {
        "Zulassungsnummer" => Model.Search.Zulassungsnummer,
        "LfdNr"             => Model.Search.LfdNr?.ToString(),
        "Zustand"           => Model.Search.Zustand,
        "ErzeugtVon"        => Model.Search.ErzeugtVon,
        _ => ""
    };
}

<input type="hidden" id="currentSortColumn" value="@Model.SortColumn" />
<input type="hidden" id="currentSortDirection" value="@Model.SortDirection" />

<input type="hidden" id="parentObjectId" value="@Model.Nebengruppe.ObjektId" />
<input type="hidden" id="currentNodeType" value="Akte" />

<div class="object-container">
    <div class="object-container-inner">
        <div class="info-header">
        <h2>
            @if (Model.Nebengruppe.Icon != null && Model.Nebengruppe.Icon.Length > 0)
            {
                var base64 = Convert.ToBase64String(Model.Nebengruppe.Icon);
                var imgSrc = $"data:image/x-icon;base64,{base64}";

                <img src="@imgSrc" style="width:1em;" />
            }
            else
            {
                <span class="toggle-icon">
                    <i class="fa-solid fa-folder"></i>
                </span>
            }
            @Model.Nebengruppe.Bezeichnung
        </h2>
        <i class="fa-solid fa-circle-info btn-info-table" title="Info zu @Model.Nebengruppe.Bezeichnung" onclick="toggleInfo('@Model.Nebengruppe.ObjektId', event)"></i>
        </div>
            <!-- Info -->
            <div id="info-@Model.Nebengruppe.ObjektId" class="info-row" style="display:none;">

                 <div class="info-content">

                    <div class="info-item">
                        <span class="info-label">Objekt-Typ:</span>
                        <span class="info-value">Nebengruppe</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Bezeichnung:</span>
                        <span class="info-value">@Model.Nebengruppe.Bezeichnung</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Kürzel:</span>
                        <span class="info-value">@Model.Nebengruppe.Kuerzel</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Kategorienummer:</span>
                        <span class="info-value">@Model.Nebengruppe.GehoertZuKategorieNummer</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Hauptgruppenummer:</span>
                        <span class="info-value">@Model.Nebengruppe.GehoertZuHauptgruppeNummer</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Nebengruppenummer:</span>
                        <span class="info-value">@Model.Nebengruppe.NebengruppeNummer</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Objekt-Id:</span>
                        <span class="info-value">
                            <a href="@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@Model.Nebengruppe.ObjektId">@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@Model.Nebengruppe.ObjektId</a>
                        </span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Beschreibung:</span>
                        <span class="info-value">@Model.Nebengruppe.Beschreibung</span>
                    </div>

                </div>

            </div>
</div>
</div>



<div class="hierarchy-table">
<div class="table-container">
    <div class="table-container-inner">
        <h2 class="table-header-text">Akten von <span>@Model.Nebengruppe.Bezeichnung</span></h2>
        <table>
            <thead>
                <tr class="search">
                    <th></th>
                    @foreach (var col in Model.Columns)
                    {
                        <th>
                            @if (col.IsSearchable)
                            {
                                if (col.ColumnKey == "ErzeugtAm")
                                {
                                    <div style="display:flex; gap:4px;">
                                        <span class="von-bis">Von:</span>
                                        <input type="date"
                                               id="searchErzeugtAmVon"
                                               value="@(Model.Search.ErzeugtAmVon?.ToString("yyyy-MM-dd"))" />
                                        <span class="von-bis">Bis:</span>
                                        <input type="date"
                                               id="searchErzeugtAmBis"
                                               value="@(Model.Search.ErzeugtAmBis?.ToString("yyyy-MM-dd"))" />
                                    </div>
                                }
                                else
                                {
                                    <input data-search-column="@col.ColumnKey" name="search"
                                           value="@GetSearchValue(col.ColumnKey)" placeholder="Suchen.." />
                                }
                            }
                        </th>
                    }
                </tr>

                <tr>
                    <th>Aktionen</th>
                    @foreach (var col in Model.Columns)
                    {
                        if (col.IsSortable)
                        {
                            @SortHeader(col.ColumnKey, col.Title, Model.SortColumn, Model.SortDirection)
                        }
                        else
                        {
                            <th>@col.Title</th>
                        }
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Akte != null && Model.Akte.Count > 0)
                {
                    foreach (var a in Model.Akte)
                    {
                        <tr class="js-table-node" data-object-id="@a.ObjektId" data-node-type="Akte">
                            <td>
                               <i class="fa-solid fa-circle-info btn-info-table" title="Info zu @a.Zulassungsnummer" onclick="toggleInfo('@a.ObjektId', event)"></i>
                               <i class="fa-solid fa-circle-chevron-right btn-info-table weiter-btn" title="Klicken um eine eben tiefer zu navigieren." style="margin-left:5px"></i>
                            </td>

                            @foreach (var col in Model.Columns)
                            {
                                switch (col.ColumnKey)
                                {
                                    case "Zulassungsnummer":
                                        <td>
                                            @if (a.Icon != null && a.Icon.Length > 0)
                                            {
                                                <img src="data:image/x-icon;base64,@Convert.ToBase64String(a.Icon)" style="width:1em;" />
                                            }
                                            else
                                            {
                                                <span class="toggle-icon"><i class="fa-solid fa-folder"></i></span>
                                            }
                                            @a.Zulassungsnummer
                                        </td>
                                        break;
                                    case "LfdNr":
                                        <td>@a.LfdNr</td>
                                        break;
                                    case "Zustand":
                                        <td>@a.Zustand</td>
                                        break;
                                    case "ErzeugtVon":
                                        <td>@a.ErzeugtVon</td>
                                        break;
                                    case "ErzeugtAm":
                                        <td>@(a.ErzeugtAm.HasValue ? a.ErzeugtAm.Value.ToString("dd.MM.yyyy") : "")</td>
                                        break;
                                    default:
                                        <td></td>
                                        break;
                                }
                            }
                        </tr>

                         <!-- Info -->

                    <tr id="info-@a.ObjektId" class="info-row" style="display:none;">
                        <td colspan="@(Model.Columns.Count + 1)">
                          <div class="info-content">

                            <div class="info-item">
                                <span class="info-label">Objekt-Typ:</span>
                                <span class="info-value">Akte</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Zulassungsnummer:</span>
                                <span class="info-value">@a.Zulassungsnummer</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Laufende Nummer:</span>
                                <span class="info-value">@a.LfdNr</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Hauptgruppenummer:</span>
                                <span class="info-value">@a.HauptgruppeNummer</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Nebengruppenummer:</span>
                                <span class="info-value">@a.NebengruppeNummer</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Zustand:</span>
                                <span class="info-value">@a.Zustand</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Erzeugt Von:</span>
                                <span class="info-value">@a.ErzeugtVon</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Erzeugt Am:</span>
                                <span class="info-value">@a.ErzeugtAm?.ToString("dd.MM.yyyy")</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Geändert Von:</span>
                                <span class="info-value">@a.GeandertVon</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Geändert Am:</span>
                                <span class="info-value">@a.GeandertAm?.ToString("dd.MM.yyyy")</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Abteilung:</span>
                                <span class="info-value">@a.Abteilung</span>
                            </div>

                             <div class="info-item">
                                <span class="info-label">Referat:</span>
                                <span class="info-value">@a.Referat</span>
                            </div>

                            <div class="info-item">
                                <span class="info-label">Objekt-Id:</span>
                                <span class="info-value">
                                    <a href="@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@a.ObjektId">@Context.Request.GetBaseUrl()/bescheidbearbeitung?ObjectId=@a.ObjektId</a>
                                </span>
                            </div>

                        </div>
                        </td>
                    </tr>
                    }
                }
                else
                {
                    <tr><td colspan="@(Model.Columns.Count + 1)" style="text-align:center;">Keine Einträge gefunden</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>



<div class="pagination-container">

    <div class="pagination-buttons">
        @{ bool isEmpty = Model.TotalPages == 0; }

        <button class="p-btn" onclick="loadPage(1)"
            @(Model.CurrentPage == 1 || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-double-left"></i>
        </button>
        <button class="p-btn" onclick="loadPage(@(Model.CurrentPage - 1))"
            @(Model.CurrentPage == 1 || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-left"></i>
        </button>

        <div class="pagination-page-info">
            <input id="currentPage" type="number" min="1"
                max="@Model.TotalPages" value="@Model.CurrentPage"
                @(isEmpty ? "disabled" : "") />
            <span class="pagination-sep">von</span>
            <span class="pagination-total">@Model.TotalPages</span>
        </div>

        <button class="p-btn" onclick="loadPage(@(Model.CurrentPage + 1))"
            @(Model.CurrentPage >= Model.TotalPages || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-right"></i>
        </button>
        <button class="p-btn" onclick="loadPage(@Model.TotalPages)"
            @(Model.CurrentPage >= Model.TotalPages || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-double-right"></i>
        </button>
    </div>

    <!-- Einträge pro Seite -->
    <div class="page-size">
        <label class="pagination-label">Einträge pro Seite</label>
        <select id="pageSizeSelect" class="pagination-select">
            @foreach (var size in new[] { 1, 5, 10, 25, 50, 100 })
            {
                var selected = Model.PageSize == size ? "selected" : "";
                @:<option value="@size" @selected>@size</option>
            }
        </select>
    </div>

    <!-- Gesamtanzahl + Actions -->
    <div class="actions2">
        <span class="pagination-label">Gesamt</span>
        <input class="pagination-count-input" name="name" value="@Model.TotalCount" readonly />
        <button id="resetBtn" class="p-btn" title="Aktualisieren">
            <i class="fa fa-sync"></i>
        </button>
        <button class="p-btn" title="Spalten anpassen" onclick="openColumnDialog('Akte')">
            <i class="fa-solid fa-table-columns"></i>
        </button>
        <button class="p-btn" onclick="loadPage(1)" title="Suchen">
            <i class="fa fa-search"></i>
        </button>
    </div>

</div>
    </div>

<script>
(function () {

const endpoint = "/bescheidbearbeitung/load-akten";
const tableContainer = () => document.getElementById("tableContainer");

function getValue(id, fallback = "") {
    return document.getElementById(id)?.value ?? fallback;
}

function getFilters() {
    const filters = {
        pageSize: getValue("pageSizeSelect", 10),

        // Parent-ObjectId (Nebengruppe), keine Tabellenspalte.
        objectId: getValue("parentObjectId"),

        // ErzeugtAm ist ein Von/Bis-Zeitraum, kein einzelnes Suchfeld,
        // deshalb hier weiterhin explizit statt über data-search-column.
        ErzeugtAmVon: getValue("searchErzeugtAmVon"),
        ErzeugtAmBis: getValue("searchErzeugtAmBis")
    };

    // Alle übrigen Spalten kommen generisch aus den Feldern mit data-search-column.
    document.querySelectorAll("[data-search-column]").forEach(i => {
        filters[i.dataset.searchColumn] = i.value;
    });

    return filters;
}

function fetchTable(params) {
    const query = new URLSearchParams(params);
    fetch(`${endpoint}?${query}`)
        .then(r => r.text())
        .then(html => {
            tableContainer().innerHTML = html;
            attachEvents();
        });
}

window.loadPage = function (page = 1) {
    fetchTable({ ...getFilters(), page });
};

window.sortTable = function (column) {
    const currentColumn = getValue("currentSortColumn");
    const currentDirection = getValue("currentSortDirection", "asc");

    const newDirection =
        currentColumn === column && currentDirection === "asc"
            ? "desc"
            : "asc";

    fetchTable({
        ...getFilters(),
        page: 1,
        sortColumn: column,
        sortDirection: newDirection
    });
};

function attachEvents() {

    // Generische Suchfelder + die beiden Von/Bis-Sonderfelder für ErzeugtAm.
    const searchInputs = () =>
        document.querySelectorAll("[data-search-column], #searchErzeugtAmVon, #searchErzeugtAmBis");

    searchInputs().forEach(input =>
        input.addEventListener("keypress", e => {
            if (e.key === "Enter") window.loadPage(1);
        })
    );

    document.getElementById("pageSizeSelect")
        ?.addEventListener("change", () => window.loadPage(1));

    document.getElementById("currentPage")
        ?.addEventListener("input", e => {
            const page = parseInt(e.target.value, 10);
            const max = parseInt(e.target.max, 10);

            if (!isNaN(page)) {
                if (page < 1) return e.target.value = 1;
                if (page > max) return e.target.value = max;
                window.loadPage(page);
            }
        });

    document.getElementById("resetBtn")
        ?.addEventListener("click", () => {
            searchInputs().forEach(i => i.value = "");
            document.getElementById("pageSizeSelect").value = 10;
            window.loadPage(1);
        });
}

attachEvents();

})();
</script>
