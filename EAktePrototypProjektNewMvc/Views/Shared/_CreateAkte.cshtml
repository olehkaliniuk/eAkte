<script>
    var abteilungReferatData = @Html.Raw(ViewBag.AbteilungReferatJson ?? "[]");
    var initialReferat = "@Model?.Referat?.Trim()";

    function populateReferatDropdown(selectedAbteilung, selectedReferat) {
        var referatSelect = document.getElementById('inputReferat');
        referatSelect.innerHTML = '';

        var filtered = abteilungReferatData.filter(function (x) {
            return x.abteilung === selectedAbteilung && x.referat;
        });

        filtered.forEach(function (item) {
            var opt = document.createElement('option');
            opt.value = item.referat;
            opt.text = item.referat;
            if (selectedReferat && item.referat === selectedReferat) {
                opt.selected = true;
            }
            referatSelect.appendChild(opt);
        });
    }

    function onAbteilungChanged() {
        var abteilungSelect = document.getElementById('inputAbteilung');
        populateReferatDropdown(abteilungSelect.value, null);
        validateTab1();
    }

    // Direkt ausführen statt auf DOMContentLoaded zu warten —
    // das Script läuft erst, nachdem container.innerHTML gesetzt wurde,
    // die Elemente existieren also bereits.
    (function initReferatDropdown() {
        var abteilungSelect = document.getElementById('inputAbteilung');
        if (abteilungSelect && abteilungSelect.value) {
            populateReferatDropdown(abteilungSelect.value, initialReferat);
        }
    })();
</script>