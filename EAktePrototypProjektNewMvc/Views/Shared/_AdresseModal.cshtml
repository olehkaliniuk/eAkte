@using Microsoft.AspNetCore.Html
@model EAktePrototypProjektNewMvc.Models.Adressen.AdresseViewModel

@functions{
    public IHtmlContent SortHeader(string column, string title, string currentColumn, string currentDirection)
    {
        var arrowHtml = "";
        if (currentColumn == column)
        {
            if (currentDirection == "asc")
                /* Pfeil nach oben — Klasse sort-asc. */
                arrowHtml = " <span class=\"sort-arrow sort-asc\">▲</span>";
            else
                /* Pfeil nach unten — Klasse sort-desc. */
                arrowHtml = " <span class=\"sort-arrow sort-desc\">▼</span>";
        }
        return new HtmlString(
            $"<th onclick=\"sortTableAdresse('{column}')\" style=\"cursor:pointer;\">{title}{arrowHtml}</th>"
        );
    }
}

<input type="hidden" id="currentSortColumnAdresse" value="@Model.SortColumn" />
<input type="hidden" id="currentSortDirectionAdresse" value="@Model.SortDirection" />

<div class="modal-body-adress">
    <table class="modal-table">
        <thead>
            <tr class="search dark-search">
                <th><input id="searchId" placeholder="Id..." value="@Model.Search?.Id" /></th>
                <th><input id="searchLand" placeholder="Land..." value="@Model.Search?.Land" /></th>
                <th><input id="searchStrasse" placeholder="Strasse..." value="@Model.Search?.Strasse" /></th>
                <th><input id="searchOrt" placeholder="Ort..." value="@Model.Search?.Ort" /></th>
                <th><input id="searchState" placeholder="State..." value="@Model.Search?.StateOrPrefecture" /></th>
                <th><input id="searchPLZ" placeholder="PLZ..." value="@Model.Search?.PLZ" /></th>
                <th><input id="searchGebaude" placeholder="Gebäude..." value="@Model.Search?.Gebaude" /></th>
                <th><input id="searchWohnung" placeholder="Wohnung..." value="@Model.Search?.Wohnung" /></th>
                <th><input id="searchOrganisation" placeholder="Organisation..." value="@Model.Search?.Organisation" /></th>
                <th><input id="searchName" placeholder="Name..." value="@Model.Search?.Name" /></th>
                <th><input id="searchBezeichnung" placeholder="Bezeichnung..." value="@Model.Search?.Bezeichnung" /></th>
                <th><input id="searchIban" placeholder="IBAN..." value="@Model.Search?.Iban" /></th>
                <th><input id="searchBic" placeholder="BIC..." value="@Model.Search?.Bic" /></th>

                <!-- IstInsolvent -->
                <th>
                    <select id="searchIstInsolvent">
                        <option value="">Alle</option>

                        @if (Model.Search?.IstInsolvent == true)
                        {
                            <option value="true" selected>Ja</option>
                        }
                        else
                        {
                            <option value="true">Ja</option>
                        }

                        @if (Model.Search?.IstInsolvent == false)
                        {
                            <option value="false" selected>Nein</option>
                        }
                        else
                        {
                            <option value="false">Nein</option>
                        }
                    </select>
                </th>

                <!-- IstAktiv -->
                <th>
                    <select id="searchIstAktiv">
                        <option value="">Alle</option>

                        @if (Model.Search?.IstAktiv == true)
                        {
                            <option value="true" selected>Ja</option>
                        }
                        else
                        {
                            <option value="true">Ja</option>
                        }

                        @if (Model.Search?.IstAktiv == false)
                        {
                            <option value="false" selected>Nein</option>
                        }
                        else
                        {
                            <option value="false">Nein</option>
                        }
                    </select>
                </th>

                <th><input id="searchAnsprechpartner" placeholder="Ansprechpartner..." value="@Model.Search?.Ansprechpartner" /></th>
                <th><input id="searchTel" placeholder="Tel..." value="@Model.Search?.AnsprechpartnerTel" /></th>
                <th><input id="searchEmail" placeholder="Email..." value="@Model.Search?.AnsprechpartnerEmail" /></th>
                <th><input id="searchReStrasse" placeholder="Rechn.Strasse..." value="@Model.Search?.RechnungsStrasse" /></th>
                <th><input id="searchReOrt" placeholder="Rechn.Ort..." value="@Model.Search?.RechnungsOrt" /></th>
                <th><input id="searchRePLZ" placeholder="Rechn.PLZ..." value="@Model.Search?.RechnungsPLZ" /></th>
                <th><input id="searchReLand" placeholder="Rechn.Land..." value="@Model.Search?.RechnungsLand" /></th>
                <th><input id="searchReState" placeholder="Rechn.State..." value="@Model.Search?.RechnungsStateOrPrefecture" /></th>
                <th><input id="searchReOrg" placeholder="Rechn.Org..." value="@Model.Search?.RechnungsOrganisation" /></th>
                <th><input id="searchReName" placeholder="Rechn.Name..." value="@Model.Search?.RechnungsName" /></th>
                <th><input id="searchGesamt" placeholder="Gesamtadresse..." value="@Model.Search?.Gesamtadresse" /></th>
                <th><input id="searchFax" placeholder="Fax..." value="@Model.Search?.Fax" /></th>
            </tr>
            <tr class="dark-search">
                @SortHeader("Id","Id",Model.SortColumn,Model.SortDirection)
                @SortHeader("Land","Land",Model.SortColumn,Model.SortDirection)
                @SortHeader("Strasse","Strasse",Model.SortColumn,Model.SortDirection)
                @SortHeader("Ort","Ort",Model.SortColumn,Model.SortDirection)
                @SortHeader("StateOrPrefecture","StateOrPrefecture",Model.SortColumn,Model.SortDirection)
                @SortHeader("PLZ","PLZ",Model.SortColumn,Model.SortDirection)
                @SortHeader("Gebaude","Gebaude",Model.SortColumn,Model.SortDirection)
                @SortHeader("Wohnung","Wohnung",Model.SortColumn,Model.SortDirection)
                @SortHeader("Organisation","Organisation",Model.SortColumn,Model.SortDirection)
                @SortHeader("Name","Name",Model.SortColumn,Model.SortDirection)
                @SortHeader("Bezeichnung","Bezeichnung",Model.SortColumn,Model.SortDirection)
                @SortHeader("Iban","Iban",Model.SortColumn,Model.SortDirection)
                @SortHeader("Bic","Bic",Model.SortColumn,Model.SortDirection)
                @SortHeader("IstInsolvent","IstInsolvent",Model.SortColumn,Model.SortDirection)
                @SortHeader("IstAktiv","IstAktiv",Model.SortColumn,Model.SortDirection)
                @SortHeader("Ansprechpartner","Ansprechpartner",Model.SortColumn,Model.SortDirection)
                @SortHeader("AnsprechpartnerTel","AnsprechpartnerTel",Model.SortColumn,Model.SortDirection)
                @SortHeader("AnsprechpartnerEmail","AnsprechpartnerEmail",Model.SortColumn,Model.SortDirection)
                @SortHeader("RechnungsStrasse","RechnungsStrasse",Model.SortColumn,Model.SortDirection)
                @SortHeader("RechnungsOrt","RechnungsOrt",Model.SortColumn,Model.SortDirection)
                @SortHeader("RechnungsPLZ","RechnungsPLZ",Model.SortColumn,Model.SortDirection)
                @SortHeader("RechnungsLand","RechnungsLand",Model.SortColumn,Model.SortDirection)
                @SortHeader("RechnungsStateOrPrefecture","RechnungsStateOrPrefecture",Model.SortColumn,Model.SortDirection)
                @SortHeader("RechnungsOrganisation","RechnungsOrganisation",Model.SortColumn,Model.SortDirection)
                @SortHeader("RechnungsName","RechnungsName",Model.SortColumn,Model.SortDirection)
                @SortHeader("Gesamtadresse","Gesamtadresse",Model.SortColumn,Model.SortDirection)
                @SortHeader("Fax","Fax",Model.SortColumn,Model.SortDirection)
            </tr>
        </thead>

        <tbody id="adresseTableBody">
            @if (Model.Adressen != null && Model.Adressen.Count > 0)
            {
                @foreach (var a in Model.Adressen)
                {
                    <tr class="dark-search" ondblclick="selectAdresse(@a.Id)">
                        <td>@a.Id</td>
                        <td>@a.Land</td>
                        <td>@a.Strasse</td>
                        <td>@a.Ort</td>
                        <td>@a.StateOrPrefecture</td>
                        <td>@a.PLZ</td>
                        <td>@a.Gebaude</td>
                        <td>@a.Wohnung</td>
                        <td>@a.Organisation</td>
                        <td>@a.Name</td>
                        <td>@a.Bezeichnung</td>
                        <td>@a.Iban</td>
                        <td>@a.Bic</td>
                        <td class="text-center">
                            <i class="fas @(a.IstInsolvent.GetValueOrDefault() ? "fa-ban icon-danger" : "fa-circle-check icon-success")"></i>
                        </td>
                        <td class="text-center">
                            <i class="fas @(a.IstAktiv.GetValueOrDefault() ? "fa-circle-check icon-success" : "fa-ban icon-danger")"></i>
                        </td>
                        <td>@a.Ansprechpartner</td>
                        <td>@a.AnsprechpartnerTel</td>
                        <td>@a.AnsprechpartnerEmail</td>
                        <td>@a.RechnungsStrasse</td>
                        <td>@a.RechnungsOrt</td>
                        <td>@a.RechnungsPLZ</td>
                        <td>@a.RechnungsLand</td>
                        <td>@a.RechnungsStateOrPrefecture</td>
                        <td>@a.RechnungsOrganisation</td>
                        <td>@a.RechnungsName</td>
                        <td>@a.Gesamtadresse</td>
                        <td>@a.Fax</td>
                    </tr>
                }
            }
            else
            {
                    <tr class="dark-search"><td colspan="27" style="text-align:center;">Keine Einträge gefunden</td></tr>
            }
        </tbody>
    </table>
</div>



<div class="pagination-container">
    <div class="pagination-buttons">
        @{ bool isEmpty = Model.TotalPages == 0; }
        <button class="p-btn" onclick="loadPageA(1)"
            @(Model.CurrentPage == 1 || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-double-left"></i>
        </button>
        <button class="p-btn" onclick="loadPageA(@(Model.CurrentPage - 1))"
            @(Model.CurrentPage == 1 || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-left"></i>
        </button>
        <div class="pagination-page-info">
            <input id="currentPageAdresse" type="number" min="1"
                max="@Model.TotalPages" value="@Model.CurrentPage"
                @(isEmpty ? "disabled" : "") />
            <span class="pagination-sep">von</span>
            <span class="pagination-total">@Model.TotalPages</span>
        </div>
        <button class="p-btn" onclick="loadPageA(@(Model.CurrentPage + 1))"
            @(Model.CurrentPage >= Model.TotalPages || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-right"></i>
        </button>
        <button class="p-btn" onclick="loadPageA(@Model.TotalPages)"
            @(Model.CurrentPage >= Model.TotalPages || isEmpty ? "disabled" : "")>
            <i class="fa fa-angle-double-right"></i>
        </button>
    </div>
    <div class="page-size">
        <label class="pagination-label">Einträge pro Seite</label>
        <select id="pageSizeSelectAdresse" class="pagination-select">
            @foreach (var size in new[] { 1, 10, 25, 50, 100 })
            {
                var selected = Model.PageSize == size ? "selected" : "";
                @:<option value="@size" @selected>@size</option>
            }
        </select>
    </div>
    <div class="actions2">
        <span class="pagination-label">Gesamt</span>
        <input class="pagination-count-input" name="name" value="@Model.TotalCount" readonly />
        <button id="resetBtnAdresse" class="p-btn" title="Aktualisieren">
            <i class="fa fa-sync"></i>
        </button>
        <button class="p-btn" onclick="loadPageA(1)" title="Suchen">
            <i class="fa fa-search"></i>
        </button>
    </div>
</div>



